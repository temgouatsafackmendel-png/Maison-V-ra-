# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: HTTP Server listening port (must be 3000 in AI Studio preview)
PORT="3000"

# SQLITE_DB_PATH: Path to SQLite database file (or ":memory:" for isolated tests)
SQLITE_DB_PATH="./data/ecommerce.sqlite"

# WEBHOOK_SECRET: Shared secret for HMAC-SHA256 signature verification on payment webhooks
# In production, inject via secret manager. Never expose to frontend.
WEBHOOK_SECRET="whsec_sandbox_test_secret_change_in_prod"

# SESSION_SECRET: Secret salt for server-side session token hashing
SESSION_SECRET="sess_sandbox_test_secret_change_in_prod"

# VITE_GOOGLE_MAPS_API_KEY: Optional Google Maps Platform browser key for live GPS courier maps
# (Falls back cleanly to built-in Pan-African topographic route radar if omitted)
VITE_GOOGLE_MAPS_API_KEY=""
